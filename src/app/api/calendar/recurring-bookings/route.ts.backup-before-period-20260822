      },
      {
        status:
          applicationError
            ? 500
            : 404,
      },
    );
  }


  const {
    data:
      recurringBooking,
    error:
      recurringError,
  } =
    await supabaseAdmin
      .from(
        "calendar_recurring_bookings",
      )
      .select(
        `
          id,
          status
        `,
      )
      .eq(
        "application_id",
        application.id,
      )
      .eq(
        "calendar_schedule_id",
        occurrence
          .calendar_schedule_id,
      )
      .eq(
        "user_id",
        auth.user.id,
      )
      .eq(
        "status",
        "active",
      )
      .maybeSingle();


  if (
    recurringError
  ) {
    return NextResponse.json(
      {
        ok: false,
        message:
          "継続予約情報を確認できませんでした。",
      },
      {
        status: 500,
      },
    );
  }


  if (
    !recurringBooking
  ) {
    return NextResponse.json({
      ok: true,
      active: false,
      cancelledCount:
        0,
    });
  }


  const now =
    new Date()
      .toISOString();


  const {
    error:
      stopError,
  } =
    await supabaseAdmin
      .from(
        "calendar_recurring_bookings",
      )
      .update({
        status:
          "stopped",

        stopped_at:
          now,

        updated_at:
          now,
      })
      .eq(
        "id",
        recurringBooking.id,
      )
      .eq(
        "user_id",
        auth.user.id,
      )
      .eq(
        "status",
        "active",
      );


  if (
    stopError
  ) {
    return NextResponse.json(
      {
        ok: false,
        message:
          "継続予約を停止できませんでした。",
      },
      {
        status: 500,
      },
    );
  }


  // 表示中の回より後だけを対象にする。
  const {
    data:
      futureOccurrences,
    error:
      futureError,
  } =
    await supabaseAdmin
      .from(
        "calendar_occurrences",
      )
      .select(
        "id",
      )
      .eq(
        "calendar_schedule_id",
        occurrence
          .calendar_schedule_id,
      )
      .gt(
        "source_starts_at",
        occurrence
          .source_starts_at,
      );


  if (
    futureError
  ) {
    return NextResponse.json(
      {
        ok: false,
        message:
          "今後の開催予定を確認できませんでした。",
      },
      {
        status: 500,
      },
    );
  }


  const futureIds =
    (
      futureOccurrences ??
      []
    ).map(
      (item) =>
        item.id,
    );


  let cancelledCount =
    0;


  if (
    futureIds.length >
    0
  ) {
    const {
      data:
        cancelledEntries,
      error:
        cancelError,
    } =
      await supabaseAdmin
        .from(
          "application_entries",
        )
        .update({
          status:
            "cancelled",
        })
        .eq(
          "calendar_recurring_booking_id",
          recurringBooking.id,
        )
        .eq(
          "user_id",
          auth.user.id,
        )
        .in(
          "calendar_occurrence_id",
          futureIds,
        )
        .in(
          "status",
          ACTIVE_ENTRY_STATUSES,
        )
        .select(
          "id",
        );


    if (
      cancelError
    ) {
      console.error(
        "[calendar recurring DELETE] cancel future entries failed:",
        cancelError,
      );

      return NextResponse.json(
        {
          ok: false,
          message:
            "継続予約は停止しましたが、今後の予約の取消処理を完了できませんでした。",
        },
        {
          status: 500,
        },
      );
    }


    cancelledCount =
      cancelledEntries
        ?.length ??
      0;
  }


  return NextResponse.json({
    ok: true,
    active: false,
    cancelledCount,
  });
}
