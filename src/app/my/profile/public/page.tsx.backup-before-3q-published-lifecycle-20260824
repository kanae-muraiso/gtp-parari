  const handleAddLink = async () => {
    if (!supabase || !userId) {
      setMessage("ログインユーザーを確認できませんでした。");
      setMessageIsError(true);
      return;
    }

    if (links.length >= 10) {
      setMessage("リンクは最大10件までです。");
      setMessageIsError(true);
      return;
    }

    const label = newLabel.trim();
    const url = newUrl.trim();
    const icon = newIcon.trim();

    if (!label) {
      setMessage("リンクの表示名を入力してください。");
      setMessageIsError(true);
      return;
    }

    if (!url) {
      setMessage("リンクのURLを入力してください。");
      setMessageIsError(true);
      return;
    }

    if (!isAllowedLinkUrl(url)) {
      setMessage(
        "URLを確認してください。https:// などから始まるURLを入力してください。",
      );
      setMessageIsError(true);
      return;
    }

    setLinkSaving(true);
    setMessage("");
    setMessageIsError(false);

    const maxOrder = links.reduce(
      (max, link) => Math.max(max, link.sort_order ?? 0),
      0,
    );

    const { error } = await supabase
      .from("profile_links")
      .insert({
        user_id: userId,
        label,
        url,
        icon: icon || null,
        sort_order: maxOrder + 1,
        is_enabled: true,
      });

    if (error) {
      setMessage(`リンクの追加に失敗しました: ${error.message}`);
      setMessageIsError(true);
      setLinkSaving(false);
      return;
    }

    const loaded = await loadLinks(userId);

    if (loaded) {
      setNewLabel("");
      setNewUrl("");
      setNewIcon("");
      setMessage("リンクを追加しました。");
      setMessageIsError(false);
    }

    setLinkSaving(false);
  };

  const handleDeleteLink = async (linkId: string) => {
    if (!supabase || !userId) {
