                      description: "SNS・外部サイト",
                    },
                    {
                      id: "works",
                      label: "代表作品",
                      description: "掲載作品",
                    },
                  ] as const
                ).map((section) => {
                  const active =
                    editorSection === section.id;

                  return (
                    <button
                      key={section.id}
                      type="button"
                      onClick={() =>
                        setEditorSection(section.id)
                      }
                      className={[
                        "rounded-2xl border px-4 py-3 text-left transition",
                        active
                          ? "border-neutral-900 bg-neutral-900 text-white"
                          : "border-neutral-200 bg-white text-neutral-700 hover:bg-neutral-50",
                      ].join(" ")}
                    >
                      <div className="text-sm font-bold">
                        {section.label}
                      </div>

                      <div
                        className={[
                          "mt-1 text-xs",
                          active
                            ? "text-neutral-300"
                            : "text-neutral-400",
                        ].join(" ")}
                      >
                        {section.description}
                      </div>
                    </button>
                  );
                })}
              </div>
            </section>

            {legacyMode && showEditor && editorSection === "brand" ? (
            <SectionCard
              number="1"
              title="基本情報"
              description="プロフィールページ上部に表示する情報を設定します。表示名とユーザーネームはプロフィール設定で変更します。"
            >
              <div className="grid gap-4 md:grid-cols-2">
                <ReadOnlyField
                  label="表示名"
                  value={displayName || "未設定"}
                />

                <ReadOnlyField
                  label="ユーザーネーム"
                  value={username ? `@${username}` : "未設定"}
                />
              </div>

              {publicProfileUrl ? (
                <div className="rounded-2xl border border-neutral-200 bg-neutral-50 p-4">
                  <div className="text-xs font-bold text-neutral-500">
                    公開URL
                  </div>

                  <div className="mt-2 break-all font-mono text-xs text-neutral-700">
                    {publicProfileUrl}
                  </div>
                </div>
              ) : null}

              <div className="space-y-2">
                <label className="block text-sm font-semibold text-neutral-900">
                  自己紹介
                </label>

                <textarea
                  value={bio}
                  onChange={(event) =>
                    setBio(event.target.value)
                  }
                  rows={6}
                  className="w-full rounded-2xl border border-neutral-300 bg-white px-4 py-3 text-sm leading-7 outline-none transition focus:border-neutral-600"
                  placeholder="あなた自身や活動について書いてください。"
                />

                <p className="text-xs leading-5 text-neutral-500">
                  プレーンテキストで保存します。HTMLは使用しません。
                </p>
              </div>

              <ImageSettingCard
                title="プロフィール画像"
                description="顔写真、個人アイコン、ロゴなどを設定できます。"
              >
                <input
                  type="file"
                  accept="image/*"
                  className="text-sm text-neutral-600 file:mr-3 file:rounded-lg file:border-0 file:bg-neutral-200 file:px-3 file:py-1.5 file:text-sm file:text-neutral-700"
                  onChange={async (event) => {
                    const file = event.target.files?.[0];

                    if (!file) return;

                    const url =
                      await uploadProfileImage(
                        file,
                        "avatar",
                      );

                    if (url) {
                      setAvatarUrl(url);
                    }
                  }}
                />

                {avatarUrl ? (
                  <div className="space-y-3">
                    {/* eslint-disable-next-line @next/next/no-img-element */}
                    <img
                      src={avatarUrl}
                      alt="プロフィール画像"
                      className={[
                        "h-24 w-24 object-cover ring-1 ring-neutral-200",
                        profileImageStyle === "circle"
                          ? "rounded-full"
                          : "rounded-xl",
                      ].join(" ")}
                    />

                    <button
                      type="button"
                      onClick={() => setAvatarUrl(null)}
                      className="text-xs font-semibold text-red-600 hover:underline"
                    >
                      プロフィール画像を削除
                    </button>
                  </div>
                ) : null}

                <div className="space-y-2">
                  <div className="text-xs font-semibold text-neutral-700">
                    表示方法
                  </div>

                  <div className="grid gap-2">
                    <ChoiceButton
                      active={profileImageStyle === "circle"}
                      title="○ 丸型で表示"
                      body="顔写真や個人アイコン向きです。"
                      onClick={() =>
                        setProfileImageStyle("circle")
                      }
                    />

                    <ChoiceButton
                      active={profileImageStyle === "logo"}
                      title="□ 四角型で表示"
                      body="ロゴやブランド画像向きです。丸く切り抜きません。"
                      onClick={() =>
                        setProfileImageStyle("logo")
                      }
                    />

                    <ChoiceButton
                      active={profileImageStyle === "none"}
                      title="表示しない"
                      body="画像を使わず、名前と文章だけを表示します。"
                      onClick={() =>
                        setProfileImageStyle("none")
                      }
                    />
                  </div>
                </div>
              </ImageSettingCard>

              <ImageSettingCard
                title="プロフィール表紙画像"
                description="プロフィールページ上部に表示する横長のカバー画像です。"
              >
                <input
                  type="file"
                  accept="image/*"
                  className="text-sm text-neutral-600 file:mr-3 file:rounded-lg file:border-0 file:bg-neutral-200 file:px-3 file:py-1.5 file:text-sm file:text-neutral-700"
                  onChange={async (event) => {
                    const file = event.target.files?.[0];

                    if (!file) return;

                    const url =
                      await uploadProfileImage(
                        file,
                        "cover",
                      );

                    if (url) {
                      setCoverImageUrl(url);
                    }
                  }}
                />

                {coverImageUrl ? (
                  <div className="space-y-3">
                    {/* eslint-disable-next-line @next/next/no-img-element */}
                    <img
                      src={coverImageUrl}
                      alt="プロフィール表紙画像"
                      className="h-40 w-full rounded-2xl object-cover ring-1 ring-neutral-200"
                    />

                    <button
                      type="button"
                      onClick={() =>
                        setCoverImageUrl(null)
                      }
                      className="text-xs font-semibold text-red-600 hover:underline"
                    >
                      表紙画像を削除
                    </button>
                  </div>
                ) : null}
              </ImageSettingCard>

              <ImageSettingCard
                title="ブランドロゴ"
                description="あなた・教室・会社・ブランドを代表する画像です。作品自身にOGP画像がない場合の代表画像として優先して使用されます。"
              >
                <input
                  type="file"
                  accept="image/*"
                  className="text-sm text-neutral-600 file:mr-3 file:rounded-lg file:border-0 file:bg-neutral-200 file:px-3 file:py-1.5 file:text-sm file:text-neutral-700"
                  onChange={async (event) => {
                    const file = event.target.files?.[0];

                    if (!file) return;

                    const url =
                      await uploadProfileImage(
                        file,
                        "logo",
                      );

                    if (url) {
                      setBrandLogoUrl(url);
                    }
                  }}
                />

                {brandLogoUrl ? (
                  <div className="space-y-3">
                    {/* eslint-disable-next-line @next/next/no-img-element */}
                    <img
                      src={brandLogoUrl}
                      alt="ブランドロゴ"
                      className="max-h-24 max-w-full rounded-xl object-contain ring-1 ring-neutral-200"
                    />

                    <button
                      type="button"
                      onClick={() =>
                        setBrandLogoUrl(null)
                      }
                      className="text-xs font-semibold text-red-600 hover:underline"
                    >
                      ブランドロゴを削除
                    </button>
                  </div>
                ) : null}

                <div className="rounded-xl bg-white px-3 py-3 text-xs leading-6 text-neutral-500">
                  OGP画像の優先順位：
                  作品画像 → ブランドロゴ → プロフィール画像 → プロフィール表紙画像 → PARARI標準画像
                </div>
              </ImageSettingCard>

              <div className="space-y-3 rounded-2xl bg-neutral-50 p-4">
                <div>
                  <div className="text-sm font-semibold text-neutral-900">
                    プロフィール表示
                  </div>
                  <p className="mt-1 text-xs leading-5 text-neutral-500">
                    名前・ユーザーネーム・プロフィール画像・自己紹介の位置を設定します。
                  </p>
                </div>

                <div className="space-y-2">
                  <div className="text-xs font-semibold text-neutral-700">
                    全体の位置
                  </div>

                  <div className="flex flex-wrap gap-2">
                    {(
                      [
                        ["left", "左"],
                        ["center", "中央"],
                        ["right", "右"],
                      ] as const
                    ).map(([value, label]) => (
                      <button
                        key={value}
                        type="button"
                        onClick={() =>
                          setProfileAlign(value)
                        }
                        className={[
                          "rounded-full border px-4 py-2 text-xs font-semibold",
                          profileAlign === value
                            ? "border-neutral-900 bg-neutral-900 text-white"
                            : "border-neutral-300 bg-white text-neutral-700",
                        ].join(" ")}
                      >
                        {label}
                      </button>
                    ))}
                  </div>
                </div>

                <label className="flex items-center gap-3 text-sm text-neutral-700">
                  <input
                    type="checkbox"
                    checked={showUsername}
                    onChange={(event) =>
                      setShowUsername(event.target.checked)
                    }
                    className="h-4 w-4"
                  />
                  ユーザーネーム（@{username || "your-name"}）を表示する
                </label>
              </div>
            </SectionCard>
            ) : null}

            {legacyMode && showEditor && editorSection === "content" ? (
            <SectionCard
              number="2"
              title="タブ設定"
              description="プロフィールページの3つのタブ名と、各タブに表示する内容を設定します。"
            >
              <div className="space-y-3 rounded-2xl border border-neutral-200 bg-neutral-50 p-4">
                <div>
                  <div className="text-sm font-bold text-neutral-900">
                    最初に開くタブ
                  </div>
                  <p className="mt-1 text-xs leading-5 text-neutral-500">
                    プロフィールページを開いたとき、最初に表示するタブを選びます。
                  </p>
                </div>

                <div className="grid gap-2 sm:grid-cols-3">
                  {(
                    [
                      ["profile", `タブ1：${tab1Label || DEFAULT_TAB_LABEL_1}`],
                      ["links", `タブ2：${tab2Label || DEFAULT_TAB_LABEL_2}`],
                      ["works", `タブ3：${tab3Label || DEFAULT_TAB_LABEL_3}`],
                    ] as const
                  ).map(([value, label]) => (
                    <button
                      key={value}
                      type="button"
                      onClick={() => setFirstTab(value)}
                      className={[
                        "rounded-xl border px-3 py-3 text-left text-sm font-semibold transition",
                        firstTab === value
                          ? "border-neutral-900 bg-neutral-900 text-white"
                          : "border-neutral-300 bg-white text-neutral-700 hover:bg-neutral-50",
                      ].join(" ")}
                    >
                      {label}
                    </button>
                  ))}
                </div>
              </div>

              <TabSetting
                number={1}
                label={tab1Label}
                setLabel={setTab1Label}
                pageType={tab1Type}
                setPageType={setTab1Type}
              />

              <TabSetting
                number={2}
                label={tab2Label}
                setLabel={setTab2Label}
                pageType={tab2Type}
                setPageType={setTab2Type}
              />

              <TabSetting
                number={3}
                label={tab3Label}
                setLabel={setTab3Label}
                pageType={tab3Type}
                setPageType={setTab3Type}
              />

              <div className="space-y-3 rounded-2xl border border-neutral-200 bg-white p-4">
                <div>
                  <div className="text-sm font-bold text-neutral-900">
                    「プロフィール」に表示する本文
                  </div>
                  <p className="mt-1 text-xs leading-5 text-neutral-500">
                    各タブの「表示する内容」で「プロフィール」を選んだときに表示する文章です。
                    上部の短い自己紹介とは別に、経歴・活動内容・考え方などを自由に書けます。
                  </p>
                </div>

                <textarea
                  value={profileBody}
                  onChange={(event) =>
                    setProfileBody(event.target.value)
                  }
                  rows={10}
                  className="w-full rounded-2xl border border-neutral-300 bg-white px-4 py-3 text-sm leading-7 outline-none transition focus:border-neutral-600"
                  placeholder={"例）\n活動について\n\nこれまでの経歴や、現在取り組んでいることなどを書いてください。"}
                />

                <p className="text-xs leading-5 text-neutral-500">
                  HTMLは使用しません。改行を保ったプレーンテキストとして表示します。
                </p>
              </div>

              <p className="text-xs leading-5 text-neutral-500">
                同じ内容を複数のタブに設定することもできます。
                初期構成は「プロフィール／リンク／代表作品」です。
              </p>
            </SectionCard>
            ) : null}

            {legacyMode && showEditor && editorSection === "links" ? (
            <SectionCard
              number="3"
              title="リンク"
              description="SNSやホームページなどへのリンクを最大10件まで登録できます。追加・削除はその場で反映されます。"
            >
              <div className="flex flex-wrap gap-2">
                {LINK_PRESETS.map((preset) => (
                  <button
                    key={preset.label}
                    type="button"
                    onClick={() => applyPreset(preset)}
                    className="rounded-full border border-neutral-300 bg-white px-3 py-1.5 text-xs hover:bg-neutral-50"
                  >
                    {preset.icon} {preset.label}
                  </button>
                ))}
              </div>

              <div className="space-y-4 rounded-2xl bg-neutral-50 p-4">
                <div className="space-y-2">
                  <label className="block text-sm font-semibold text-neutral-900">
                    表示名
                  </label>

                  <input
                    value={newLabel}
                    onChange={(event) =>
                      setNewLabel(event.target.value)
                    }
                    className="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm"
                    placeholder="例）Instagram"
                  />
                </div>

                <div className="space-y-2">
                  <label className="block text-sm font-semibold text-neutral-900">
                    URL
                  </label>

                  <input
                    value={newUrl}
                    onChange={(event) =>
                      setNewUrl(event.target.value)
                    }
                    className="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm"
                    placeholder="https://..."
                    autoCapitalize="none"
                    autoCorrect="off"
                    spellCheck={false}
                  />
                </div>

                <div className="space-y-2">
                  <label className="block text-sm font-semibold text-neutral-900">
                    アイコン（任意）
                  </label>

                  <input
                    value={newIcon}
                    onChange={(event) =>
                      setNewIcon(event.target.value)
                    }
                    className="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm"
                    placeholder="例）📷"
                  />
                </div>

                <button
                  type="button"
                  onClick={handleAddLink}
                  disabled={
                    linkSaving || links.length >= 10
                  }
                  className="w-full rounded-xl bg-neutral-900 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-700 disabled:cursor-not-allowed disabled:bg-neutral-300"
                >
                  {linkSaving
                    ? "追加中..."
                    : links.length >= 10
                      ? "最大10件です"
                      : "リンクを追加"}
                </button>
              </div>

              <div className="space-y-2">
                {links.length === 0 ? (
                  <div className="rounded-2xl border border-dashed border-neutral-300 px-4 py-5 text-sm text-neutral-400">
                    まだリンクがありません。
                  </div>
                ) : (
                  links.map((link) => (
                    <div
                      key={link.id}
                      className="flex items-center justify-between gap-3 rounded-2xl border border-neutral-200 px-4 py-3"
                    >
                      <div className="min-w-0">
                        <div className="truncate text-sm font-semibold text-neutral-900">
                          <span className="mr-2">
                            {link.icon || "🔗"}
                          </span>
                          {link.label}
                        </div>

                        <div className="mt-1 truncate text-xs text-neutral-500">
                          {link.url}
                        </div>
                      </div>

                      <button
                        type="button"
                        onClick={() =>
                          handleDeleteLink(link.id)
                        }
                        className="shrink-0 text-xs font-semibold text-red-600 hover:underline"
                      >
                        削除
                      </button>
                    </div>
                  ))
                )}
              </div>
            </SectionCard>
            ) : null}

            {legacyMode && showEditor && editorSection === "works" ? (
            <SectionCard
              number="4"
              title="代表作品"
              description="あなたの公開作品から、プロフィールページに掲載する代表作品を選びます。"
            >
              <div className="flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-neutral-50 p-4">
                <div>
                  <div className="text-sm font-semibold text-neutral-900">
                    選択中 {selectedWorks.length}作品
                  </div>

                  <p className="mt-1 text-xs leading-5 text-neutral-500">
                    {representativeWorkLimit === null
                      ? "現在のプランでは代表作品数を制限していません。"
                      : `Freeプランでは最大${representativeWorkLimit}作品まで掲載できます。`}
                  </p>
                </div>

                <div className="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-neutral-600 ring-1 ring-neutral-200">
                  {isMonitor
                    ? "Monitor"
                    : effectivePlan.toUpperCase()}
                </div>
              </div>

              {displayWorks.length === 0 ? (
                <div className="rounded-2xl border border-dashed border-neutral-300 px-4 py-5 text-sm text-neutral-400">
                  プロフィールに掲載できる公開作品がまだありません。
                </div>
              ) : (
                <div className="space-y-2">
                  {displayWorks.map((work) => {
                    const checked =
                      Boolean(work.show_in_profile_works);
                    const selectedIndex =
                      selectedWorks.findIndex(
                        (item) => item.id === work.id,
                      );

                    return (
                      <div
                        key={work.id}
                        className={[
                          "rounded-2xl border p-4",
                          checked
                            ? "border-neutral-400 bg-neutral-50"
                            : "border-neutral-200 bg-white",
                        ].join(" ")}
                      >
                        <div className="flex items-start gap-3">
                          <input
                            type="checkbox"
                            checked={checked}
                            disabled={
                              workSavingId === work.id
                            }
                            onChange={() =>
                              handleToggleRepresentativeWork(
                                work,
                              )
                            }
                            className="mt-1 h-4 w-4 shrink-0"
                          />

                          <div className="min-w-0 flex-1">
                            <div className="text-sm font-semibold text-neutral-900">
                              {work.title?.trim() ||
                                "無題の作品"}
                            </div>

                            <div className="mt-1 text-xs text-neutral-500">
                              {checked
                                ? `表示順 ${
                                    work.profile_works_order ??
                                    selectedIndex + 1
                                  }`
                                : "代表作品には掲載していません"}
                            </div>
                          </div>

                          {checked ? (
                            <div className="flex shrink-0 gap-1">
                              <button
                                type="button"
                                disabled={
                                  selectedIndex <= 0 ||
                                  movingWorkId !== null
                                }
                                onClick={() =>
                                  handleMoveRepresentativeWork(
                                    work.id,
                                    "up",
                                  )
                                }
                                className="rounded-lg border border-neutral-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-neutral-700 disabled:opacity-30"
                              >
                                ↑
                              </button>

                              <button
                                type="button"
                                disabled={
                                  selectedIndex < 0 ||
                                  selectedIndex >=
                                    selectedWorks.length - 1 ||
                                  movingWorkId !== null
                                }
                                onClick={() =>
                                  handleMoveRepresentativeWork(
                                    work.id,
                                    "down",
                                  )
                                }
                                className="rounded-lg border border-neutral-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-neutral-700 disabled:opacity-30"
                              >
                                ↓
                              </button>
                            </div>
                          ) : null}
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}

              <p className="text-xs leading-5 text-neutral-500">
                非公開作品はここには表示しません。
                表示形式やカラム数は将来この設定に追加できます。
              </p>
            </SectionCard>
            ) : null}

            {message ? (
              <div
                className={[
                  "rounded-2xl border px-4 py-3 text-sm leading-6",
                  messageIsError
                    ? "border-rose-200 bg-rose-50 text-rose-700"
                    : "border-neutral-200 bg-white text-neutral-700",
                ].join(" ")}
              >
                {message}
              </div>
            ) : null}

            <div
              className={
                legacyMode && showEditor
                  ? "sticky bottom-3 rounded-3xl border border-neutral-200 bg-white/95 p-3 shadow-lg backdrop-blur"
                  : "hidden"
              }
            >
              <div className="flex flex-wrap gap-2">
                <button
                  type="button"
                  onClick={handleSave}
                  disabled={saving}
                  className="rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-700 disabled:cursor-not-allowed disabled:bg-neutral-300"
                >
                  {saving
                    ? "保存中..."
                    : "プロフィール設定を保存"}
                </button>

                {publicProfileUrl ? (
                  <a
                    href={publicProfileUrl}
                    target="_blank"
                    rel="noreferrer"
                    className="rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-neutral-700 ring-1 ring-neutral-200 transition hover:bg-neutral-50"
                  >
                    公開ページを見る
                  </a>
                ) : null}

                <a
                  href="/my/profile"
                  className="rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-neutral-700 ring-1 ring-neutral-200 transition hover:bg-neutral-50"
                >
                  戻る
                </a>
              </div>
            </div>
          </>
        )}
      </div>
    </main>
  );
}

function SectionCard({
  number,
  title,
  description,
  children,
}: {
  number: string;
  title: string;
  description: string;
  children: React.ReactNode;
}) {
  return (
    <section className="rounded-3xl border border-neutral-200 bg-white p-5 shadow-sm">
      <div className="flex items-start gap-3">
        <div className="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-neutral-900 text-xs font-bold text-white">
          {number}
        </div>

        <div>
          <div className="text-sm font-bold text-neutral-900">
            {title}
          </div>

          <p className="mt-1 text-xs leading-5 text-neutral-500">
            {description}
          </p>
        </div>
      </div>

      <div className="mt-5 space-y-5">
        {children}
      </div>
    </section>
  );
}

function ReadOnlyField({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div className="space-y-2">
      <div className="text-sm font-semibold text-neutral-900">
        {label}
      </div>

      <div className="rounded-2xl bg-neutral-50 px-4 py-3 text-sm text-neutral-800">
        {value}
      </div>
    </div>
  );
}

function ImageSettingCard({
  title,
  description,
  children,
}: {
  title: string;
  description: string;
  children: React.ReactNode;
}) {
  return (
    <div className="space-y-4 rounded-2xl bg-neutral-50 p-4">
      <div>
        <div className="text-sm font-semibold text-neutral-900">
          {title}
        </div>

        <p className="mt-1 text-xs leading-5 text-neutral-500">
          {description}
        </p>
      </div>

      {children}
    </div>
  );
}

function ChoiceButton({
  active,
  title,
  body,
  onClick,
}: {
  active: boolean;
  title: string;
  body: string;
  onClick: () => void;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      className={[
        "rounded-xl border p-3 text-left transition",
        active
          ? "border-neutral-900 bg-white"
          : "border-neutral-200 bg-white/70 hover:bg-white",
      ].join(" ")}
    >
      <div className="text-sm font-semibold text-neutral-900">
        {title}
      </div>

      <div className="mt-1 text-xs leading-5 text-neutral-500">
        {body}
      </div>
    </button>
  );
}

