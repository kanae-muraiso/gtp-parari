  const handleMoveRepresentativeWork = async (
    workId: string,
    direction: "up" | "down",
  ) => {
    if (!supabase || !userId) return;

    const ordered = [...selectedWorks];
    const currentIndex = ordered.findIndex(
      (work) => work.id === workId,
    );

    if (currentIndex < 0) return;

    const targetIndex =
      direction === "up"
        ? currentIndex - 1
        : currentIndex + 1;

    if (targetIndex < 0 || targetIndex >= ordered.length) {
      return;
    }

    const currentWork = ordered[currentIndex];
    const targetWork = ordered[targetIndex];

    const currentOrder =
      currentWork.profile_works_order ?? currentIndex + 1;
    const targetOrder =
      targetWork.profile_works_order ?? targetIndex + 1;

    setMovingWorkId(workId);
    setMessage("");
    setMessageIsError(false);

    const { error: firstError } = await supabase
      .from("parari_books")
