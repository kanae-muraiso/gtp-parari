      current.map((item) => {
        if (item.id === currentWork.id) {
          return {
            ...item,
            profile_works_order: targetOrder,
          };
        }

        if (item.id === targetWork.id) {
          return {
            ...item,
            profile_works_order: currentOrder,
          };
        }

        return item;
      }),
    );

