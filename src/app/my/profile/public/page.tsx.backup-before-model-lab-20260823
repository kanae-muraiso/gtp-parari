                </div>

                <textarea
                  value={profileBody}
                  onChange={(event) =>
                    setProfileBody(event.target.value)
                  }
                  rows={12}
                  className="w-full rounded-2xl border border-neutral-300 bg-white px-4 py-4 text-sm leading-7 outline-none transition focus:border-neutral-600"
                  placeholder={
                    selectedPagePattern === "story-first"
                      ? "例）最初は、自分のために始めました。\n\nでも続けているうちに……"
                      : selectedPagePattern === "welcome-first"
                        ? "例）初めての方がほとんどです。\n一人でも気軽に来てください。"
                        : selectedPagePattern === "offer-first"
                          ? "例）この活動を始めたのは……\nいちばん届けたいのは……"
                          : "例）普段どんなことをしているのか、\nなぜ続けているのかを書いてみてください。"
                  }
                />

                <div className="flex items-start gap-3 rounded-2xl bg-white p-4 text-xs leading-6 text-neutral-500">
                  <div className="mt-0.5 text-base">
                    “
                  </div>

                  <div>
                    上手な文章でなくても大丈夫です。
                    このページでは、あなた自身のことばであることを大切にします。
                  </div>
                </div>
              </div>
            </SectionCard>
            ) : null}

            {showEditor && editorSection === "links" ? (
            <SectionCard
              number="4"
              title={
                selectedPagePattern === "offer-first"
                  ? "興味を持った人に、次に何をしてほしいですか？"
                  : selectedPagePattern === "story-first"
                    ? "共感した人と、どうつながりますか？"
                    : selectedPagePattern === "welcome-first"
                      ? "次の一歩を、どこへ案内しますか？"
                      : "興味を持った人を、どこへつなぎますか？"
              }
              description="SNSやホームページなど、このページの先にある場所を登録します。最大10件まで追加できます。"
            >
              <div className="flex flex-wrap gap-2">
                {LINK_PRESETS.map((preset) => (
                  <button
                    key={preset.label}
                    type="button"
                    onClick={() => applyPreset(preset)}
                    className="rounded-full border border-neutral-300 bg-white px-3 py-1.5 text-xs hover:bg-neutral-50"
                  >
                    {preset.icon} {preset.label}
                  </button>
                ))}
              </div>

              <div className="space-y-4 rounded-2xl bg-neutral-50 p-4">
                <div className="space-y-2">
                  <label className="block text-sm font-semibold text-neutral-900">
                    表示名
                  </label>

                  <input
                    value={newLabel}
                    onChange={(event) =>
                      setNewLabel(event.target.value)
                    }
                    className="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm"
                    placeholder="例）Instagram"
                  />
                </div>

                <div className="space-y-2">
                  <label className="block text-sm font-semibold text-neutral-900">
                    URL
                  </label>

                  <input
                    value={newUrl}
                    onChange={(event) =>
                      setNewUrl(event.target.value)
                    }
                    className="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm"
                    placeholder="https://..."
                    autoCapitalize="none"
                    autoCorrect="off"
                    spellCheck={false}
                  />
                </div>

                <div className="space-y-2">
                  <label className="block text-sm font-semibold text-neutral-900">
                    アイコン（任意）
                  </label>

                  <input
                    value={newIcon}
                    onChange={(event) =>
                      setNewIcon(event.target.value)
                    }
                    className="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm"
                    placeholder="例）📷"
                  />
                </div>

                <button
                  type="button"
                  onClick={handleAddLink}
                  disabled={
                    linkSaving || links.length >= 10
                  }
                  className="w-full rounded-xl bg-neutral-900 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-700 disabled:cursor-not-allowed disabled:bg-neutral-300"
                >
                  {linkSaving
                    ? "追加中..."
                    : links.length >= 10
                      ? "最大10件です"
                      : "リンクを追加"}
                </button>
              </div>

              <div className="space-y-2">
                {links.length === 0 ? (
                  <div className="rounded-2xl border border-dashed border-neutral-300 px-4 py-5 text-sm text-neutral-400">
                    まだリンクがありません。
                  </div>
                ) : (
                  links.map((link) => (
                    <div
                      key={link.id}
                      className="flex items-center justify-between gap-3 rounded-2xl border border-neutral-200 px-4 py-3"
                    >
                      <div className="min-w-0">
                        <div className="truncate text-sm font-semibold text-neutral-900">
                          <span className="mr-2">
                            {link.icon || "🔗"}
                          </span>
                          {link.label}
                        </div>

                        <div className="mt-1 truncate text-xs text-neutral-500">
                          {link.url}
                        </div>
                      </div>

                      <button
                        type="button"
                        onClick={() =>
                          handleDeleteLink(link.id)
                        }
                        className="shrink-0 text-xs font-semibold text-red-600 hover:underline"
                      >
                        削除
                      </button>
                    </div>
                  ))
                )}
              </div>
            </SectionCard>
            ) : null}

            {showEditor && editorSection === "works" ? (
            <SectionCard
              number={
                selectedPagePattern === "offer-first"
                  ? "1"
                  : "3"
              }
              title={
                selectedPagePattern === "offer-first"
                  ? "まず、何を見てもらいますか？"
                  : selectedPagePattern === "story-first"
                    ? "その考えが形になったものは何ですか？"
                    : selectedPagePattern === "welcome-first"
                      ? "最初の一歩として、何を見てもらいますか？"
                      : "あなたの何を見てもらいますか？"
              }
              description="公開している作品から、このページで特に見てほしいものを選びます。"
            >
              <div className="flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-neutral-50 p-4">
                <div>
                  <div className="text-sm font-semibold text-neutral-900">
                    選択中 {selectedWorks.length}作品
                  </div>

                  <p className="mt-1 text-xs leading-5 text-neutral-500">
                    {representativeWorkLimit === null
                      ? "現在のプランでは代表作品数を制限していません。"
                      : `Freeプランでは最大${representativeWorkLimit}作品まで掲載できます。`}
                  </p>
                </div>

                <div className="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-neutral-600 ring-1 ring-neutral-200">
                  {isMonitor
                    ? "Monitor"
                    : effectivePlan.toUpperCase()}
                </div>
              </div>

              {displayWorks.length === 0 ? (
                <div className="rounded-2xl border border-dashed border-neutral-300 px-4 py-5 text-sm text-neutral-400">
                  プロフィールに掲載できる公開作品がまだありません。
                </div>
              ) : (
                <div className="space-y-2">
                  {displayWorks.map((work) => {
                    const checked =
                      Boolean(work.show_in_profile_works);
                    const selectedIndex =
                      selectedWorks.findIndex(
                        (item) => item.id === work.id,
                      );

                    return (
                      <div
                        key={work.id}
                        className={[
                          "rounded-2xl border p-4",
                          checked
                            ? "border-neutral-400 bg-neutral-50"
                            : "border-neutral-200 bg-white",
                        ].join(" ")}
                      >
                        <div className="flex items-start gap-3">
                          <input
                            type="checkbox"
                            checked={checked}
                            disabled={
                              workSavingId === work.id
                            }
                            onChange={() =>
                              handleToggleRepresentativeWork(
                                work,
                              )
                            }
                            className="mt-1 h-4 w-4 shrink-0"
                          />

                          <div className="min-w-0 flex-1">
                            <div className="text-sm font-semibold text-neutral-900">
                              {work.title?.trim() ||
                                "無題の作品"}
                            </div>

                            <div className="mt-1 text-xs text-neutral-500">
                              {checked
                                ? `表示順 ${
                                    work.profile_works_order ??
                                    selectedIndex + 1
                                  }`
                                : "代表作品には掲載していません"}
                            </div>
                          </div>

                          {checked ? (
                            <div className="flex shrink-0 gap-1">
                              <button
                                type="button"
                                disabled={
                                  selectedIndex <= 0 ||
                                  movingWorkId !== null
                                }
                                onClick={() =>
                                  handleMoveRepresentativeWork(
                                    work.id,
                                    "up",
                                  )
                                }
                                className="rounded-lg border border-neutral-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-neutral-700 disabled:opacity-30"
                              >
                                ↑
                              </button>

                              <button
                                type="button"
                                disabled={
                                  selectedIndex < 0 ||
                                  selectedIndex >=
                                    selectedWorks.length - 1 ||
                                  movingWorkId !== null
                                }
                                onClick={() =>
                                  handleMoveRepresentativeWork(
                                    work.id,
                                    "down",
                                  )
                                }
                                className="rounded-lg border border-neutral-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-neutral-700 disabled:opacity-30"
                              >
                                ↓
                              </button>
                            </div>
                          ) : null}
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}

              <p className="text-xs leading-5 text-neutral-500">
                非公開作品はここには表示しません。
                表示形式やカラム数は将来この設定に追加できます。
              </p>
            </SectionCard>
            ) : null}

            {message ? (
              <div
                className={[
                  "rounded-2xl border px-4 py-3 text-sm leading-6",
                  messageIsError
                    ? "border-rose-200 bg-rose-50 text-rose-700"
                    : "border-neutral-200 bg-white text-neutral-700",
                ].join(" ")}
              >
                {message}
              </div>
            ) : null}

            <div
              className={
                showEditor
                  ? "sticky bottom-3 rounded-3xl border border-neutral-200 bg-white/95 p-3 shadow-lg backdrop-blur"
                  : "hidden"
              }
            >
              <div className="flex flex-wrap gap-2">
                <button
                  type="button"
                  onClick={handleSave}
                  disabled={saving}
                  className="rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-neutral-700 disabled:cursor-not-allowed disabled:bg-neutral-300"
                >
                  {saving
                    ? "保存中..."
                    : "ページに反映する"}
                </button>

                {publicProfileUrl ? (
                  <a
                    href={publicProfileUrl}
                    target="_blank"
                    rel="noreferrer"
                    className="rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-neutral-700 ring-1 ring-neutral-200 transition hover:bg-neutral-50"
                  >
                    公開ページを見る
                  </a>
                ) : null}

                <a
                  href="/my/profile"
                  className="rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-neutral-700 ring-1 ring-neutral-200 transition hover:bg-neutral-50"
                >
                  戻る
                </a>
              </div>
            </div>
          </>
        )}
      </div>
    </main>
  );
}

function SectionCard({
  number,
  title,
  description,
  children,
}: {
  number: string;
  title: string;
  description: string;
  children: React.ReactNode;
}) {
  return (
    <section className="rounded-3xl border border-neutral-200 bg-white p-5 shadow-sm">
      <div className="flex items-start gap-3">
        <div className="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-neutral-900 text-xs font-bold text-white">
          {number}
        </div>

        <div>
          <div className="text-sm font-bold text-neutral-900">
            {title}
          </div>

          <p className="mt-1 text-xs leading-5 text-neutral-500">
            {description}
          </p>
        </div>
      </div>

      <div className="mt-5 space-y-5">
        {children}
      </div>
    </section>
  );
}

function ReadOnlyField({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div className="space-y-2">
      <div className="text-sm font-semibold text-neutral-900">
        {label}
      </div>

      <div className="rounded-2xl bg-neutral-50 px-4 py-3 text-sm text-neutral-800">
        {value}
      </div>
    </div>
  );
}

function ImageSettingCard({
  title,
  description,
  children,
}: {
  title: string;
  description: string;
  children: React.ReactNode;
}) {
  return (
    <div className="space-y-4 rounded-2xl bg-neutral-50 p-4">
      <div>
        <div className="text-sm font-semibold text-neutral-900">
          {title}
        </div>

        <p className="mt-1 text-xs leading-5 text-neutral-500">
          {description}
        </p>
      </div>

      {children}
    </div>
  );
}

function ChoiceButton({
  active,
  title,
  body,
  onClick,
}: {
  active: boolean;
  title: string;
  body: string;
  onClick: () => void;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      className={[
        "rounded-xl border p-3 text-left transition",
        active
          ? "border-neutral-900 bg-white"
          : "border-neutral-200 bg-white/70 hover:bg-white",
      ].join(" ")}
    >
      <div className="text-sm font-semibold text-neutral-900">
        {title}
      </div>

      <div className="mt-1 text-xs leading-5 text-neutral-500">
        {body}
      </div>
    </button>
  );
}

function TabSetting({
  number,
  label,
  setLabel,
  pageType,
  setPageType,
}: {
  number: number;
  label: string;
  setLabel: (value: string) => void;
  pageType: ProfilePageType;
  setPageType: (value: ProfilePageType) => void;
}) {
  return (
    <div className="space-y-4 rounded-2xl border border-neutral-200 bg-neutral-50 p-4">
      <div className="text-sm font-bold text-neutral-900">
        タブ{number}
      </div>

      <div className="space-y-2">
        <label className="block text-sm font-semibold text-neutral-900">
          タブ名
        </label>

        <input
          value={label}
          onChange={(event) =>
            setLabel(event.target.value)
          }
          className="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm"
          placeholder={`タブ${number}の名前`}
        />
      </div>

      <div className="space-y-2">
        <label className="block text-sm font-semibold text-neutral-900">
          表示する内容
        </label>

        <select
          value={pageType}
          onChange={(event) =>
            setPageType(
              event.target.value as ProfilePageType,
            )
          }
          className="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm"
        >
          <option value="profile">
            プロフィール
          </option>
          <option value="links">
            リンク
          </option>
          <option value="works">
            代表作品
          </option>
        </select>
      </div>
    </div>
  );
}

function isAllowedLinkUrl(value: string): boolean {
  try {
    const url = new URL(value);

    return (
      url.protocol === "https:" ||
      url.protocol === "http:" ||
      url.protocol === "mailto:" ||
      url.protocol === "tel:"
    );
  } catch {
    return false;
  }
}
