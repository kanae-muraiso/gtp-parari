// PART: Public profile settings
//
// 公開プロフィール /{username}/profile の管理画面。
// - username / display_name は /my/profile 側で管理
// - bio / avatar / cover / brand logo を編集
// - プロフィール画像の表示形式・配置を編集
// - 3タブの名前と内容を編集
// - profile_links を編集
// - show_in_profile_works / profile_works_order で代表作品を編集
// - Free は代表作品3件まで（monitor は制限なし）
// - HTMLは扱わず bio はプレーンテキスト

"use client";

import {
  useCallback,
  useEffect,
  useMemo,
  useState,
} from "react";
import { supabase as sharedSupabase } from "@/lib/supabaseClient";
import { getEffectivePlan } from "@/lib/billing/plan";
import SettingsTabs from "@/components/parari/settings/SettingsTabs";
import PublicPageStrategyWizard, {
  PUBLIC_PAGE_PATTERN_LABELS,
  type PublicPagePattern,
} from "@/components/parari/public-page/PublicPageStrategyWizard";

type ProfileImageStyle = "circle" | "logo" | "none";
type ProfileAlign = "left" | "center" | "right";
type ProfilePageType = "profile" | "links" | "works";
type EffectivePlan = "free" | "plus" | "pro";

type PublicProfileEditorSection =
  | "brand"
  | "content"
  | "links"
  | "works";

type ProfileRow = {
  user_id: string;
  username: string | null;
  display_name: string | null;
  bio: string | null;
  profile_body: string | null;
  avatar_url: string | null;
  cover_image_url: string | null;
  homepage_header_logo_url: string | null;
  homepage_profile_image_style: string | null;
  homepage_profile_align: string | null;
  homepage_show_username: boolean | null;
  tab_label_profile: string | null;
  tab_label_links: string | null;
  tab_label_works: string | null;
  homepage_tab1_type: string | null;
  homepage_tab2_type: string | null;
  homepage_tab3_type: string | null;
  firstlook_tag_key: string | null;
  is_monitor: boolean | null;
  public_page_pattern: string | null;
};

type ProfileLinkRow = {
  id: string;
  user_id: string;
  label: string;
  url: string;
  icon: string | null;
  sort_order: number | null;
  is_enabled: boolean | null;
};

type PublicWorkRow = {
  id: string;
  title: string | null;
  content: string | null;
  visibility: string | null;
  is_public: boolean | null;
  stable_slug: string | null;
  custom_slug: string | null;
  slug: string | null;
  show_in_profile_works: boolean | null;
  profile_works_order: number | null;
  is_deleted: boolean | null;
  created_at: string | null;
  updated_at: string | null;
};

type BillingRow = {
  plan: string | null;
  billing_status: string | null;
};

const LINK_PRESETS = [
  { label: "ホームページ", icon: "🌐" },
  { label: "Instagram", icon: "📷" },
  { label: "Threads", icon: "🧵" },
  { label: "X", icon: "𝕏" },
  { label: "YouTube", icon: "▶️" },
  { label: "TikTok", icon: "🎵" },
  { label: "Facebook", icon: "📘" },
  { label: "LinkedIn", icon: "💼" },
  { label: "LINE公式", icon: "💬" },
  { label: "note", icon: "📝" },
];

const DEFAULT_TAB_LABEL_1 = "プロフィール";
const DEFAULT_TAB_LABEL_2 = "リンク";
const DEFAULT_TAB_LABEL_3 = "代表作品";

function normalizePageType(
  value: string | null | undefined,
  fallback: ProfilePageType,
): ProfilePageType {
  if (value === "profile" || value === "links" || value === "works") {
    return value;
  }

  return fallback;
}

function normalizeProfileImageStyle(
  value: string | null | undefined,
): ProfileImageStyle {
  if (value === "circle" || value === "logo" || value === "none") {
    return value;
  }

  return "circle";
}

function normalizeProfileAlign(
  value: string | null | undefined,
): ProfileAlign {
  if (value === "left" || value === "center" || value === "right") {
    return value;
  }

  return "left";
}


function normalizePublicPagePattern(
  value: string | null | undefined,
): PublicPagePattern | null {
  if (
    value === "person-first" ||
    value === "offer-first" ||
    value === "story-first" ||
    value === "welcome-first"
  ) {
    return value;
  }

  return null;
}

export default function MyPublicProfileSettingsPage() {
  const supabase = useMemo(() => sharedSupabase, []);

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [linkSaving, setLinkSaving] = useState(false);
  const [workSavingId, setWorkSavingId] = useState<string | null>(null);
  const [movingWorkId, setMovingWorkId] = useState<string | null>(null);

  const [userId, setUserId] = useState<string | null>(null);

  const [username, setUsername] = useState("");
  const [displayName, setDisplayName] = useState("");
  const [bio, setBio] = useState("");
  const [profileBody, setProfileBody] = useState("");

  const [avatarUrl, setAvatarUrl] = useState<string | null>(null);
  const [coverImageUrl, setCoverImageUrl] = useState<string | null>(null);
  const [brandLogoUrl, setBrandLogoUrl] = useState<string | null>(null);

  const [profileImageStyle, setProfileImageStyle] =
    useState<ProfileImageStyle>("circle");
  const [profileAlign, setProfileAlign] =
    useState<ProfileAlign>("left");
  const [showUsername, setShowUsername] = useState(true);

  const [tab1Label, setTab1Label] = useState(DEFAULT_TAB_LABEL_1);
  const [tab2Label, setTab2Label] = useState(DEFAULT_TAB_LABEL_2);
  const [tab3Label, setTab3Label] = useState(DEFAULT_TAB_LABEL_3);

  const [tab1Type, setTab1Type] = useState<ProfilePageType>("profile");
  const [tab2Type, setTab2Type] = useState<ProfilePageType>("links");
  const [tab3Type, setTab3Type] = useState<ProfilePageType>("works");

  // firstlook_tag_key は歴史的なDB名だが、
  // 現在は「最初に開くタブ位置」として使う。
  // profile = タブ1 / links = タブ2 / works = タブ3
  const [firstTab, setFirstTab] = useState<ProfilePageType>("profile");

  const [links, setLinks] = useState<ProfileLinkRow[]>([]);
  const [works, setWorks] = useState<PublicWorkRow[]>([]);

  const [editorSection, setEditorSection] =
    useState<PublicProfileEditorSection>("brand");

  const [showEditor, setShowEditor] = useState(false);
  const [selectedPagePattern, setSelectedPagePattern] =
    useState<PublicPagePattern | null>(null);

  const [newLabel, setNewLabel] = useState("");
  const [newUrl, setNewUrl] = useState("");
  const [newIcon, setNewIcon] = useState("");

  const [effectivePlan, setEffectivePlan] =
    useState<EffectivePlan>("free");
  const [isMonitor, setIsMonitor] = useState(false);

  const [message, setMessage] = useState("");
  const [messageIsError, setMessageIsError] = useState(false);

  const publicProfileUrl = username
    ? `/${encodeURIComponent(username)}/profile`
    : null;

  const representativeWorkLimit =
    isMonitor || effectivePlan !== "free" ? null : 3;

  const selectedWorks = useMemo(() => {
    return works
      .filter((work) => work.show_in_profile_works)
      .sort((a, b) => {
        const ao = a.profile_works_order ?? 999999;
        const bo = b.profile_works_order ?? 999999;

        if (ao !== bo) {
          return ao - bo;
        }

        return String(b.updated_at ?? "").localeCompare(
          String(a.updated_at ?? ""),
        );
      });
  }, [works]);

  const displayWorks = useMemo(() => {
    const selectedIds = new Set(selectedWorks.map((work) => work.id));

    const unselected = works
      .filter((work) => !selectedIds.has(work.id))
      .sort((a, b) =>
        String(b.updated_at ?? b.created_at ?? "").localeCompare(
          String(a.updated_at ?? a.created_at ?? ""),
        ),
      );

    return [...selectedWorks, ...unselected];
  }, [selectedWorks, works]);

  const loadLinks = useCallback(
    async (uid: string) => {
      if (!supabase) return false;

      const { data, error } = await supabase
        .from("profile_links")
        .select(
          "id, user_id, label, url, icon, sort_order, is_enabled",
        )
        .eq("user_id", uid)
        .eq("is_enabled", true)
        .order("sort_order", {
          ascending: true,
        });

      if (error) {
        setMessage(`リンクの読込に失敗しました: ${error.message}`);
        setMessageIsError(true);
        return false;
      }

      setLinks((data ?? []) as ProfileLinkRow[]);
      return true;
    },
    [supabase],
  );

  const loadWorks = useCallback(
    async (uid: string) => {
      if (!supabase) return false;

      const { data, error } = await supabase
        .from("parari_books")
        .select(
          "id,title,content,visibility,is_public,stable_slug,custom_slug,slug,show_in_profile_works,profile_works_order,is_deleted,created_at,updated_at",
        )
        .eq("owner", uid)
        .or("is_public.eq.true,visibility.eq.public")
        .order("updated_at", {
          ascending: false,
        });

      if (error) {
        setMessage(`作品一覧の読込に失敗しました: ${error.message}`);
        setMessageIsError(true);
        return false;
      }

      const visibleWorks: PublicWorkRow[] = (data ?? []).filter(
        (work) => work.is_deleted !== true,
      );

      setWorks(visibleWorks);
      return true;
    },
    [supabase],
  );

  const loadBilling = useCallback(
    async (uid: string) => {
      if (!supabase) return;

      const { data, error } = await supabase
        .from("user_billing")
        .select("plan, billing_status")
        .eq("user_id", uid)
        .maybeSingle<BillingRow>();

      if (error) {
        console.warn(
          "[profile/public] failed to load billing:",
          error,
        );
        setEffectivePlan("free");
        return;
      }

      setEffectivePlan(
        getEffectivePlan(data ?? null) as EffectivePlan,
      );
    },
    [supabase],
  );

  const loadProfile = useCallback(async () => {
    if (!supabase) {
      setMessage("Supabase環境変数がありません。");
      setMessageIsError(true);
      setLoading(false);
      return;
    }

    setLoading(true);
    setMessage("");
    setMessageIsError(false);

    const {
      data: { user },
      error: userError,
    } = await supabase.auth.getUser();

    if (userError || !user) {
      setMessage("公開ページをつくるにはログインが必要です。");
      setMessageIsError(true);
      setLoading(false);
      return;
    }

    setUserId(user.id);

    const { data: profile, error: profileError } = await supabase
      .from("profiles")
      .select(
        [
          "user_id",
          "username",
          "display_name",
          "bio",
          "profile_body",
          "avatar_url",
          "cover_image_url",
          "homepage_header_logo_url",
          "homepage_profile_image_style",
          "homepage_profile_align",
          "homepage_show_username",
          "tab_label_profile",
          "tab_label_links",
          "tab_label_works",
          "homepage_tab1_type",
          "homepage_tab2_type",
          "homepage_tab3_type",
          "firstlook_tag_key",
          "is_monitor",
          "public_page_pattern",
        ].join(","),
      )
      .eq("user_id", user.id)
      .maybeSingle<ProfileRow>();

    if (profileError) {
      setMessage(
        `プロフィールの読込に失敗しました: ${profileError.message}`,
      );
      setMessageIsError(true);
      setLoading(false);
      return;
    }

    if (!profile) {
      setMessage(
        "プロフィールがまだありません。先にプロフィール設定を行ってください。",
      );
      setMessageIsError(true);
      setLoading(false);
      return;
    }

    setUsername(profile.username ?? "");

    const loadedPagePattern =
      normalizePublicPagePattern(
        profile.public_page_pattern,
      );

    setSelectedPagePattern(
      loadedPagePattern,
    );

    if (loadedPagePattern) {
      setEditorSection(
        loadedPagePattern === "offer-first"
          ? "works"
          : loadedPagePattern === "story-first" ||
              loadedPagePattern === "welcome-first"
            ? "content"
            : "brand",
      );
    }

    setShowEditor(
      Boolean(loadedPagePattern),
    );
    setDisplayName(profile.display_name ?? "");
    setBio(profile.bio ?? "");
    setProfileBody(profile.profile_body ?? "");
    setAvatarUrl(profile.avatar_url ?? null);
    setCoverImageUrl(profile.cover_image_url ?? null);
    setBrandLogoUrl(profile.homepage_header_logo_url ?? null);

    setProfileImageStyle(
      normalizeProfileImageStyle(
        profile.homepage_profile_image_style,
      ),
    );
    setProfileAlign(
      normalizeProfileAlign(profile.homepage_profile_align),
    );
    setShowUsername(profile.homepage_show_username !== false);

    setTab1Label(
      profile.tab_label_profile?.trim() || DEFAULT_TAB_LABEL_1,
    );
    setTab2Label(
      profile.tab_label_links?.trim() || DEFAULT_TAB_LABEL_2,
    );
    setTab3Label(
      profile.tab_label_works?.trim() || DEFAULT_TAB_LABEL_3,
    );

    setTab1Type(
      normalizePageType(profile.homepage_tab1_type, "profile"),
    );
    setTab2Type(
      normalizePageType(profile.homepage_tab2_type, "links"),
    );
    setTab3Type(
      normalizePageType(profile.homepage_tab3_type, "works"),
    );

    setFirstTab(
      normalizePageType(profile.firstlook_tag_key, "profile"),
    );

    setIsMonitor(profile.is_monitor === true);

    await Promise.all([
      loadLinks(user.id),
      loadWorks(user.id),
      loadBilling(user.id),
    ]);

    setLoading(false);
  }, [
    loadBilling,
    loadLinks,
    loadWorks,
    supabase,
  ]);

  useEffect(() => {
    void loadProfile();
  }, [loadProfile]);

  const uploadProfileImage = async (
    file: File,
    type: "avatar" | "cover" | "logo",
  ): Promise<string | null> => {
    if (!supabase || !userId) {
      setMessage("ログインユーザーを確認できませんでした。");
      setMessageIsError(true);
      return null;
    }

    const rawExt = file.name.split(".").pop() || "jpg";
    const ext = rawExt.toLowerCase();
    const fileName = `${type}-${Date.now()}.${ext}`;
    const path = `${userId}/${fileName}`;

    setMessage("画像をアップロードしています...");
    setMessageIsError(false);

    const { error } = await supabase.storage
      .from("parari-images")
      .upload(path, file, {
        upsert: true,
      });

    if (error) {
      setMessage(`画像のアップロードに失敗しました: ${error.message}`);
      setMessageIsError(true);
      return null;
    }

    const { data } = supabase.storage
      .from("parari-images")
      .getPublicUrl(path);

    setMessage(
      "画像をアップロードしました。最後に「ページに反映する」を押してください。",
    );
    setMessageIsError(false);

    return data.publicUrl;
  };

  const handleSave = async () => {
    if (!supabase || !userId) {
      setMessage("ログインユーザーを確認できませんでした。");
      setMessageIsError(true);
      return;
    }

    const nextTab1Label =
      tab1Label.trim() || DEFAULT_TAB_LABEL_1;
    const nextTab2Label =
      tab2Label.trim() || DEFAULT_TAB_LABEL_2;
    const nextTab3Label =
      tab3Label.trim() || DEFAULT_TAB_LABEL_3;

    setSaving(true);
    setMessage("");
    setMessageIsError(false);

    const { data, error } = await supabase
      .from("profiles")
      .update({
        bio: bio.trim() || null,
        profile_body: profileBody.trim() || null,
        avatar_url: avatarUrl,
        cover_image_url: coverImageUrl,
        homepage_header_logo_url: brandLogoUrl,
        homepage_profile_image_style: profileImageStyle,
        homepage_profile_align: profileAlign,
        homepage_show_username: showUsername,

        public_page_pattern:
          selectedPagePattern,


        tab_label_profile: nextTab1Label,
        tab_label_links: nextTab2Label,
        tab_label_works: nextTab3Label,

        homepage_tab1_type: tab1Type,
        homepage_tab2_type: tab2Type,
        homepage_tab3_type: tab3Type,
        firstlook_tag_key: firstTab,

        // 今回のプロフィールページは3タブ構成に固定する。
        homepage_menu_count: 3,
      })
      .eq("user_id", userId)
      .select("user_id");

    if (error) {
      setMessage(`プロフィールの保存に失敗しました: ${error.message}`);
      setMessageIsError(true);
      setSaving(false);
      return;
    }

    if (!data || data.length === 0) {
      setMessage(
        "プロフィールが見つかりません。先にプロフィール設定を行ってください。",
      );
      setMessageIsError(true);
      setSaving(false);
      return;
    }

    setTab1Label(nextTab1Label);
    setTab2Label(nextTab2Label);
    setTab3Label(nextTab3Label);

    setMessage("公開ページをつくるを保存しました。");
    setMessageIsError(false);
    setSaving(false);
  };

  const applyPreset = (preset: {
    label: string;
    icon: string;
  }) => {
    setNewLabel(preset.label);
    setNewIcon(preset.icon);
  };

  const handleAddLink = async () => {
    if (!supabase || !userId) {
      setMessage("ログインユーザーを確認できませんでした。");
      setMessageIsError(true);
      return;
    }

    if (links.length >= 10) {
      setMessage("リンクは最大10件までです。");
      setMessageIsError(true);
      return;
    }

    const label = newLabel.trim();
    const url = newUrl.trim();
    const icon = newIcon.trim();

    if (!label) {
      setMessage("リンクの表示名を入力してください。");
      setMessageIsError(true);
      return;
    }

    if (!url) {
      setMessage("リンクのURLを入力してください。");
      setMessageIsError(true);
      return;
    }

    if (!isAllowedLinkUrl(url)) {
      setMessage(
        "URLを確認してください。https:// などから始まるURLを入力してください。",
      );
      setMessageIsError(true);
      return;
    }

    setLinkSaving(true);
    setMessage("");
    setMessageIsError(false);

    const maxOrder = links.reduce(
      (max, link) => Math.max(max, link.sort_order ?? 0),
      0,
    );

    const { error } = await supabase
      .from("profile_links")
      .insert({
        user_id: userId,
        label,
        url,
        icon: icon || null,
        sort_order: maxOrder + 1,
        is_enabled: true,
      });

    if (error) {
      setMessage(`リンクの追加に失敗しました: ${error.message}`);
      setMessageIsError(true);
      setLinkSaving(false);
      return;
    }

    const loaded = await loadLinks(userId);

    if (loaded) {
      setNewLabel("");
      setNewUrl("");
      setNewIcon("");
      setMessage("リンクを追加しました。");
      setMessageIsError(false);
    }

    setLinkSaving(false);
  };

  const handleDeleteLink = async (linkId: string) => {
    if (!supabase || !userId) {
      return;
    }

    const { error } = await supabase
      .from("profile_links")
      .update({
        is_enabled: false,
      })
      .eq("id", linkId)
      .eq("user_id", userId);

    if (error) {
      setMessage(`リンクの削除に失敗しました: ${error.message}`);
      setMessageIsError(true);
      return;
    }

    setLinks((current) =>
      current.filter((link) => link.id !== linkId),
    );

    setMessage("リンクを削除しました。");
    setMessageIsError(false);
  };

  const handleToggleRepresentativeWork = async (
    work: PublicWorkRow,
  ) => {
    if (!supabase || !userId) return;

    const nextShow = !Boolean(work.show_in_profile_works);

    if (
      nextShow &&
      representativeWorkLimit !== null &&
      selectedWorks.length >= representativeWorkLimit
    ) {
      setMessage(
        `Freeプランでは代表作品を${representativeWorkLimit}作品まで掲載できます。`,
      );
      setMessageIsError(true);
      return;
    }

    const nextOrder = nextShow
      ? Math.max(
          0,
          ...selectedWorks.map(
            (item) => item.profile_works_order ?? 0,
          ),
        ) + 1
      : null;

    setWorkSavingId(work.id);
    setMessage("");
    setMessageIsError(false);

    const { error } = await supabase
      .from("parari_books")
      .update({
        show_in_profile_works: nextShow,
        profile_works_order: nextOrder,
      })
      .eq("id", work.id)
      .eq("owner", userId);

    if (error) {
      setMessage(`代表作品の更新に失敗しました: ${error.message}`);
      setMessageIsError(true);
      setWorkSavingId(null);
      return;
    }

    setWorks((current) =>
      current.map((item) =>
        item.id === work.id
          ? {
              ...item,
              show_in_profile_works: nextShow,
              profile_works_order: nextOrder,
            }
          : item,
      ),
    );

    setMessage(
      nextShow
        ? "代表作品に追加しました。"
        : "代表作品から外しました。",
    );
    setMessageIsError(false);
    setWorkSavingId(null);
  };

  const handleMoveRepresentativeWork = async (
    workId: string,
    direction: "up" | "down",
  ) => {
    if (!supabase || !userId) return;

    const ordered = [...selectedWorks];
    const currentIndex = ordered.findIndex(
      (work) => work.id === workId,
    );

    if (currentIndex < 0) return;

    const targetIndex =
      direction === "up"
        ? currentIndex - 1
        : currentIndex + 1;

    if (targetIndex < 0 || targetIndex >= ordered.length) {
      return;
    }

    const currentWork = ordered[currentIndex];
    const targetWork = ordered[targetIndex];

    const currentOrder =
      currentWork.profile_works_order ?? currentIndex + 1;
    const targetOrder =
      targetWork.profile_works_order ?? targetIndex + 1;

    setMovingWorkId(workId);
    setMessage("");
    setMessageIsError(false);

    const { error: firstError } = await supabase
      .from("parari_books")
      .update({
        profile_works_order: targetOrder,
      })
      .eq("id", currentWork.id)
      .eq("owner", userId);

    if (firstError) {
      setMessage(`表示順の更新に失敗しました: ${firstError.message}`);
      setMessageIsError(true);
      setMovingWorkId(null);
      return;
    }

    const { error: secondError } = await supabase
      .from("parari_books")
      .update({
        profile_works_order: currentOrder,
      })
      .eq("id", targetWork.id)
      .eq("owner", userId);

    if (secondError) {
      await loadWorks(userId);
      setMessage(
        `表示順の更新が途中で失敗しました: ${secondError.message}`,
      );
      setMessageIsError(true);
      setMovingWorkId(null);
      return;
    }

    setWorks((current) =>
      current.map((item) => {
        if (item.id === currentWork.id) {
          return {
            ...item,
            profile_works_order: targetOrder,
          };
        }

        if (item.id === targetWork.id) {
          return {
            ...item,
            profile_works_order: currentOrder,
          };
        }

        return item;
      }),
    );

    setMessage("代表作品の表示順を変更しました。");
