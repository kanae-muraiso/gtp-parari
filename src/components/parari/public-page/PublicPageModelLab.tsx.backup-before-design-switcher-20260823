export default function PublicPageModelLab({
  initialPattern,
  onBack,
}: {
  initialPattern: PublicPagePattern;
  onBack: () => void;
}) {
  const [pattern, setPattern] =
    useState<PublicPagePattern>(initialPattern);

  const [draft, setDraft] =
    useState<Draft>(EMPTY_DRAFT);

  const setField = (
    key: keyof Draft,
    value: string,
  ) => {
    setDraft((current) => ({
      ...current,
      [key]: value,
    }));
  };

  return (
    <section className="space-y-6">
      <div className="rounded-[32px] bg-neutral-950 p-6 text-white sm:p-8">
        <div className="text-[10px] font-black tracking-[0.22em] text-neutral-500">
          MODEL LAB
        </div>

        <h2 className="mt-3 text-2xl font-black sm:text-3xl">
          まず、4つの完成形を見てみます。
        </h2>

        <p className="mt-3 max-w-2xl text-sm leading-7 text-neutral-400">
          まだ何も書かなくて構いません。
          空欄のままでも、ページの構成と印象は確認できます。
        </p>

        <button
          type="button"
          onClick={onBack}
          className="mt-5 rounded-full border border-neutral-700 px-4 py-2 text-xs font-bold text-neutral-300"
        >
          ← PAGE STRATEGYへ
        </button>
      </div>

      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {PATTERNS.map((item) => {
          const selected =
            item.id === pattern;

          return (
            <button
              key={item.id}
              type="button"
              onClick={() =>
                setPattern(item.id)
              }
              className={[
                "overflow-hidden rounded-[28px] border text-left transition",
                selected
                  ? "border-neutral-950 ring-2 ring-neutral-950"
                  : "border-neutral-200 hover:border-neutral-500",
              ].join(" ")}
            >
              <MiniModel pattern={item.id} />

              <div className="bg-white p-4">
                <div className="text-[9px] font-black tracking-[0.16em] text-neutral-400">
                  {item.code}
                </div>

                <div className="mt-2 text-sm font-black text-neutral-950">
                  {item.title}
                </div>

                <div className="mt-1 text-xs leading-5 text-neutral-500">
                  {item.description}
                </div>
              </div>
            </button>
          );
        })}
      </div>

      <div className="grid gap-6 lg:grid-cols-[340px_1fr]">
        <aside className="space-y-4 rounded-[32px] border border-neutral-200 bg-neutral-50 p-5">
          <div>
            <div className="text-[10px] font-black tracking-[0.18em] text-neutral-400">
              TEST CONTENT
            </div>

            <div className="mt-2 text-lg font-black">
              空欄を試しに埋める
            </div>

            <p className="mt-1 text-xs leading-6 text-neutral-500">
              ここは保存しません。
              モデルを考えるための実験用です。
            </p>
          </div>

          <Field
            label="NAME"
            value={draft.name}
            placeholder="名前"
            rows={1}
            onChange={(value) =>
              setField("name", value)
            }
          />

          <Field
            label="HEADLINE"
            value={draft.headline}
            placeholder="最初のひとこと"
            onChange={(value) =>
              setField("headline", value)
            }
          />

          <Field
            label="INTRO"
            value={draft.intro}
            placeholder="短い紹介"
            onChange={(value) =>
              setField("intro", value)
            }
          />

          <Field
            label="ABOUT"
            value={draft.about}
            placeholder="あなたについて"
            rows={4}
            onChange={(value) =>
              setField("about", value)
            }
          />

          <Field
            label="ORIGIN"
            value={draft.origin}
            placeholder="始めたきっかけ"
            rows={3}
            onChange={(value) =>
              setField("origin", value)
            }
          />

          <Field
            label="VALUE"
            value={draft.value}
            placeholder="大切にしていること"
            onChange={(value) =>
              setField("value", value)
            }
          />

          <Field
            label="ACTIVITY"
            value={draft.activity}
            placeholder="今している活動"
            rows={3}
            onChange={(value) =>
              setField("activity", value)
