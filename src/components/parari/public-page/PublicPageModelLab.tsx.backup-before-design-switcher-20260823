function Placeholder({
  children,
}: {
  children: React.ReactNode;
}) {
  return (
    <span className="text-neutral-400">
      {children}
    </span>
  );
}

function Text({
  value,
  placeholder,
}: {
  value: string;
  placeholder: string;
}) {
  return value.trim() ? (
    <>{value}</>
  ) : (
    <Placeholder>{placeholder}</Placeholder>
  );
}

