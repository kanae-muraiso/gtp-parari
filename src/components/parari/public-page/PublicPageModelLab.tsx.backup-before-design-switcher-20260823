        </aside>

        <div>
          <div className="mb-3 text-[10px] font-black tracking-[0.18em] text-neutral-400">
            LIVE MODEL / {
              PATTERNS.find(
                (item) => item.id === pattern,
              )?.code
            }
          </div>

          <FullModel
            pattern={pattern}
            draft={draft}
          />
        </div>
      </div>
    </section>
  );
}
