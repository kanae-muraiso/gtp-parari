function Text({
  value,
  placeholder,
  placeholderClassName = "opacity-35",
}: {
  value: string;
  placeholder: string;
  placeholderClassName?: string;
}) {
  return value.trim() ? (
    <>{value}</>
  ) : (
    <span className={placeholderClassName}>
      {placeholder}
    </span>
  );
}

