function recommendPattern(
  impact: FirstImpact,
): PublicPagePattern {
  if (impact === "person" || impact === "trust") {
    return "person-first";
  }

  if (impact === "story") {
    return "story-first";
  }

  if (impact === "ease") {
    return "welcome-first";
  }

  return "offer-first";
}

function initials(name: string) {
  const trimmed = name.trim();
  return trimmed ? trimmed.slice(0, 1) : "P";
}

