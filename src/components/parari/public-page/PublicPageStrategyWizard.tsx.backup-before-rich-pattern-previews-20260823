                  PURPOSE ✓
                </span>
              ) : null}

              {audience ? (
                <span className="rounded-full bg-neutral-100 px-3 py-1.5 text-xs font-bold text-neutral-600">
                  AUDIENCE ✓
                </span>
              ) : null}

              {impact ? (
                <span className="rounded-full bg-neutral-100 px-3 py-1.5 text-xs font-bold text-neutral-600">
                  FIRST IMPACT ✓
                </span>
              ) : null}
            </div>

            <div className="grid gap-4 lg:grid-cols-2">
              {orderedPatterns.map((pattern) => {
                const recommended =
                  pattern.id === recommendedPattern;
                const selected =
                  pattern.id === selectedPattern;

                return (
                  <button
                    key={pattern.id}
                    type="button"
                    onClick={() =>
                      setSelectedPattern(pattern.id)
                    }
                    className={[
                      "rounded-3xl border p-4 text-left transition sm:p-5",
                      selected
                        ? "border-neutral-950 ring-2 ring-neutral-950"
                        : "border-neutral-200 hover:border-neutral-500",
                    ].join(" ")}
                  >
                    <div className="flex items-start justify-between gap-3">
                      <div>
                        <div className="text-[10px] font-black tracking-[0.18em] text-neutral-400">
                          {PUBLIC_PAGE_PATTERN_LABELS[
                            pattern.id
                          ]}
                        </div>

                        <div className="mt-2 text-lg font-black text-neutral-950">
                          {pattern.title}
                        </div>
                      </div>

                      {recommended ? (
                        <span className="shrink-0 rounded-full bg-neutral-950 px-3 py-1 text-[10px] font-black text-white">
                          おすすめ
                        </span>
                      ) : null}
                    </div>

                    <p className="mt-2 text-xs leading-6 text-neutral-500">
                      {pattern.description}
                    </p>

                    <div className="mt-5 rounded-2xl bg-neutral-100 px-3 py-5">
                      <PhonePreview
                        pattern={pattern.id}
                        displayName={displayName}
                        bio={bio}
                        avatarUrl={avatarUrl}
                        coverImageUrl={coverImageUrl}
                      />
                    </div>

                    <div className="mt-4 text-center text-xs font-bold text-neutral-500">
                      {pattern.action}
                    </div>
                  </button>
                );
              })}
            </div>

            <div className="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
              <button
                type="button"
                onClick={() =>
                  onStartEditing(
                    selectedPattern ??
                      recommendedPattern,
                  )
                }
                className="rounded-full bg-neutral-950 px-6 py-3 text-sm font-black text-white transition hover:bg-neutral-700"
              >
                このパターンでページを編集する
              </button>

              <button
                type="button"
                onClick={reset}
                className="rounded-full px-5 py-3 text-sm font-bold text-neutral-500 transition hover:bg-neutral-100 hover:text-neutral-900"
              >
                最初から考え直す
              </button>
            </div>

            <p className="mt-5 text-xs leading-6 text-neutral-400">
              この段階では選択内容は保存しません。
              まず「この作り方が気持ちいいか」を試すためのページ戦略です。
            </p>
          </div>
        ) : null}
      </div>
    </section>
  );
}
