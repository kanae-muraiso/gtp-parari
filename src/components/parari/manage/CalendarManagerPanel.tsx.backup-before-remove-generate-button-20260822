"use client";

import * as React from "react";

import {
  supabase,
} from "@/lib/supabaseClient";

import CalendarMonthView from "@/components/parari/manage/CalendarMonthView";
import CalendarBookingControl from "@/components/parari/manage/CalendarBookingControl";


type CalendarItem = {
  id: string;
  title: string;
  duration_minutes: number;
  location: string | null;
  capacity: number | null;
  minimum_capacity: number | null;
  fee_amount: number | null;
  fee_currency: string;
  description_work_id: string | null;
  status: "active" | "archived";
  created_at: string;
  updated_at: string;
};


type RecurrenceRule = {
  freq?: string;
  interval?: number;
  byWeekday?: number[];
  byMonthDay?: number[];
};


type CalendarSchedule = {
  id: string;
  calendar_item_id: string;
  timezone: string;
  start_date: string;
  start_time: string;
  end_date: string | null;
  recurrence_rule: RecurrenceRule;
  status:
    | "active"
    | "paused"
    | "ended";
  created_at: string;
  updated_at: string;
};


type CalendarOccurrenceSummary = {
  id: string;
  calendar_item_id: string;
  calendar_schedule_id:
    | string
    | null;
  starts_at: string;
  ends_at: string;
  status:
    | "scheduled"
    | "cancelled"
    | "completed";
};


type CreateDraft = {
  title: string;
  durationMinutes: string;
  location: string;
  capacity: string;
  minimumCapacity: string;
  feeAmount: string;
};


type RecurrenceType =
  | "once"
  | "weekly"
  | "biweekly"
  | "monthly";


type ScheduleDraft = {
  recurrenceType:
    RecurrenceType;
  startDate: string;
  startTime: string;
  endDate: string;
  timezone: string;
};


const INITIAL_DRAFT:
  CreateDraft = {
    title: "",
    durationMinutes: "60",
    location: "",
    capacity: "",
    minimumCapacity: "",
    feeAmount: "",
  };


function getTodayInputValue() {
  const now =
    new Date();

  const year =
    now.getFullYear();

  const month =
    String(
      now.getMonth() + 1,
    ).padStart(
      2,
      "0",
    );

  const day =
    String(
      now.getDate(),
    ).padStart(
      2,
      "0",
    );

  return `${year}-${month}-${day}`;
}


function createInitialScheduleDraft():
  ScheduleDraft {
  return {
    recurrenceType:
      "once",

    startDate:
      getTodayInputValue(),

    startTime:
      "10:00",

    endDate:
      "",

    timezone:
      "Asia/Tokyo",
  };
}


function getScheduleLabel(
  schedule: CalendarSchedule,
): string {
  const rule =
    schedule.recurrence_rule ??
    {};

  if (
    rule.freq ===
    "once"
  ) {
    return "1回だけ";
  }

  if (
    rule.freq ===
      "weekly" &&
    rule.interval === 2
  ) {
    return "隔週";
  }

  if (
    rule.freq ===
    "weekly"
  ) {
    return "毎週";
  }

  if (
    rule.freq ===
    "monthly"
  ) {
    return "毎月";
  }

  return "定期";
}


function formatStartTime(
  value: string,
) {
  return value.slice(
    0,
    5,
  );
}


export default function CalendarManagerPanel() {
  const [
    items,
    setItems,
  ] =
    React.useState<
      CalendarItem[]
    >([]);


  const [
    schedules,
    setSchedules,
  ] =
    React.useState<
      CalendarSchedule[]
    >([]);


  const [
    loading,
    setLoading,
  ] =
    React.useState(true);


  const [
    creating,
    setCreating,
  ] =
    React.useState(false);


  const [
    saving,
    setSaving,
  ] =
    React.useState(false);


  const [
    message,
    setMessage,
  ] =
    React.useState("");


  const [
    draft,
    setDraft,
  ] =
    React.useState<CreateDraft>(
      INITIAL_DRAFT,
    );


  const [
    scheduleItemId,
    setScheduleItemId,
  ] =
    React.useState<
      string | null
    >(null);


  const [
    scheduleDraft,
    setScheduleDraft,
  ] =
    React.useState<ScheduleDraft>(
      createInitialScheduleDraft(),
    );


  const [
    scheduleSaving,
    setScheduleSaving,
  ] =
    React.useState(false);


  const [
    editingExistingScheduleId,
    setEditingExistingScheduleId,
  ] =
    React.useState<
      string | null
    >(null);


  const [
    editingExistingEndDate,
    setEditingExistingEndDate,
  ] =
    React.useState("");


  const [
    existingScheduleSaving,
    setExistingScheduleSaving,
  ] =
    React.useState(false);


  const [
    generatingOccurrences,
    setGeneratingOccurrences,
  ] =
    React.useState(false);


  const [
    occurrenceRefreshKey,
    setOccurrenceRefreshKey,
  ] =
    React.useState(0);


  const [
    occurrenceSummaries,
    setOccurrenceSummaries,
  ] =
    React.useState<
      CalendarOccurrenceSummary[]
    >([]);


  const [
    showEndedItems,
    setShowEndedItems,
  ] =
    React.useState(false);


  async function getAccessToken() {
    const {
      data: { session },
    } =
      await supabase.auth
        .getSession();

    return (
      session?.access_token ??
      null
    );
  }


  async function loadOccurrenceSummaries() {
    try {
      const accessToken =
        await getAccessToken();


      if (!accessToken) {
        setOccurrenceSummaries(
          [],
        );

        return;
      }


      const response =
        await fetch(
          "/api/calendar/occurrences",
          {
            method:
              "GET",

            headers: {
              Authorization:
                `Bearer ${accessToken}`,
            },

            cache:
              "no-store",
          },
        );


      const result =
        await response
          .json()
          .catch(
            () => null,
          );


      if (
        !response.ok ||
        !result?.ok
      ) {
        setOccurrenceSummaries(
          [],
        );

        return;
      }


      setOccurrenceSummaries(
        Array.isArray(
          result.occurrences,
        )
          ? result.occurrences
          : [],
      );
    } catch (error) {
      console.error(
        "[CalendarManagerPanel] occurrence summary load failed:",
        error,
      );

      setOccurrenceSummaries(
        [],
      );
    }
  }


  async function loadData() {
    setLoading(true);
    setMessage("");

    try {
      const accessToken =
        await getAccessToken();

      if (!accessToken) {
        setItems([]);
        setSchedules([]);

        setMessage(
          "カレンダーを利用するにはログインしてください。",
        );

        return;
      }


      const headers = {
        Authorization:
          `Bearer ${accessToken}`,
      };


      const [
        itemsResponse,
        schedulesResponse,
      ] =
        await Promise.all([
          fetch(
            "/api/calendar/items",
            {
              method: "GET",
              headers,
              cache:
                "no-store",
            },
          ),

          fetch(
            "/api/calendar/schedules",
            {
              method: "GET",
              headers,
              cache:
                "no-store",
            },
          ),
        ]);


      const [
        itemsResult,
        schedulesResult,
      ] =
        await Promise.all([
          itemsResponse
            .json()
            .catch(
              () => null,
            ),

          schedulesResponse
            .json()
            .catch(
              () => null,
            ),
        ]);


      if (
        !itemsResponse.ok ||
        !itemsResult?.ok
      ) {
        setItems([]);
        setSchedules([]);

        setMessage(
          itemsResult?.message ??
            "クラス・イベント一覧を取得できませんでした。",
        );

        return;
      }


      setItems(
        Array.isArray(
          itemsResult.items,
        )
          ? itemsResult.items
          : [],
      );


      if (
        schedulesResponse.ok &&
        schedulesResult?.ok &&
        Array.isArray(
          schedulesResult
            .schedules,
        )
      ) {
        setSchedules(
          schedulesResult.schedules,
        );
      } else {
        setSchedules([]);
      }
    } catch (error) {
      console.error(
        "[CalendarManagerPanel] load failed:",
        error,
      );

      setItems([]);
      setSchedules([]);

      setMessage(
        "カレンダー情報を取得できませんでした。",
      );
    } finally {
      setLoading(false);
    }
  }


  React.useEffect(() => {
    void loadData();
  }, []);


  React.useEffect(() => {
    void loadOccurrenceSummaries();
  }, [
    occurrenceRefreshKey,
  ]);


  function updateDraft(
    key: keyof CreateDraft,
    value: string,
  ) {
    setDraft(
      (current) => ({
        ...current,
        [key]:
          value,
      }),
    );
  }


  function updateScheduleDraft(
    key: keyof ScheduleDraft,
    value: string,
  ) {
    setScheduleDraft(
      (current) => ({
        ...current,
        [key]:
          value,
      }),
    );
  }


  async function createItem() {
    if (saving) return;

    setMessage("");

    const title =
      draft.title.trim();

    if (!title) {
      setMessage(
        "クラス・イベント名を入力してください。",
      );

      return;
    }


    const duration =
      Number(
        draft.durationMinutes,
      );

    if (
      !Number.isFinite(
        duration,
      ) ||
      duration <= 0
    ) {
      setMessage(
        "時間を1分以上で入力してください。",
      );

      return;
    }


    setSaving(true);


    try {
      const accessToken =
        await getAccessToken();

      if (!accessToken) {
        setMessage(
          "ログイン情報を確認できませんでした。",
        );

        return;
      }


      const response =
        await fetch(
          "/api/calendar/items",
          {
            method: "POST",

            headers: {
              Authorization:
                `Bearer ${accessToken}`,

              "Content-Type":
                "application/json",
            },

            body:
              JSON.stringify({
                title:
                  draft.title,

                durationMinutes:
                  draft.durationMinutes,

                location:
                  draft.location,

                capacity:
                  draft.capacity,

                minimumCapacity:
                  draft.minimumCapacity,

                feeAmount:
                  draft.feeAmount,

                feeCurrency:
                  "JPY",
              }),
          },
        );


      const result =
        await response
          .json()
          .catch(
            () => null,
          );


      if (
        !response.ok ||
        !result?.ok ||
        !result.item
      ) {
        setMessage(
          result?.message ??
            "クラス・イベントを作成できませんでした。",
        );

        return;
      }


      setItems(
        (current) => [
          result.item,
          ...current,
        ],
      );


      setDraft(
        INITIAL_DRAFT,
      );

      setCreating(false);

      setMessage(
        "クラス・イベントを作成しました。",
      );
    } catch (error) {
      console.error(
        "[CalendarManagerPanel] create failed:",
        error,
      );

      setMessage(
        "クラス・イベントを作成できませんでした。",
      );
    } finally {
      setSaving(false);
    }
  }


  function openSchedule(
    itemId: string,
  ) {
    setEditingExistingScheduleId(
      null,
    );

    setEditingExistingEndDate(
      "",
    );


    setScheduleItemId(
      itemId,
    );

    setScheduleDraft(
      createInitialScheduleDraft(),
    );

    setMessage("");
  }


  function closeSchedule() {
    setScheduleItemId(
      null,
    );

    setScheduleDraft(
      createInitialScheduleDraft(),
    );
  }


  async function saveSchedule() {
    if (
      !scheduleItemId ||
      scheduleSaving
    ) {
      return;
    }


    setMessage("");


    if (
      !scheduleDraft
        .startDate
    ) {
      setMessage(
        "開始日を入力してください。",
      );

      return;
    }


    if (
      !scheduleDraft
        .startTime
    ) {
      setMessage(
        "開始時刻を入力してください。",
      );

      return;
    }


    setScheduleSaving(
      true,
    );


    try {
      const accessToken =
        await getAccessToken();

      if (!accessToken) {
        setMessage(
          "ログイン情報を確認できませんでした。",
        );

        return;
      }


      const response =
        await fetch(
          "/api/calendar/schedules",
          {
            method:
              "POST",

            headers: {
              Authorization:
                `Bearer ${accessToken}`,

              "Content-Type":
                "application/json",
            },

            body:
              JSON.stringify({
                calendarItemId:
                  scheduleItemId,

                recurrenceType:
                  scheduleDraft
                    .recurrenceType,

                startDate:
                  scheduleDraft
                    .startDate,

                startTime:
                  scheduleDraft
                    .startTime,

                endDate:
                  scheduleDraft
                    .endDate,

                timezone:
                  scheduleDraft
                    .timezone,
              }),
          },
        );


      const result =
        await response
          .json()
          .catch(
            () => null,
          );


      if (
        !response.ok ||
        !result?.ok ||
        !result.schedule
      ) {
        setMessage(
          result?.message ??
            "日時を設定できませんでした。",
        );

        return;
      }


      setSchedules(
        (current) => [
          ...current,
          result.schedule,
        ],
      );


      /*
       * SCHEDULE保存後、
       * 実際の開催回を自動生成する。
       */
      const occurrenceResponse =
        await fetch(
          "/api/calendar/occurrences",
          {
            method:
              "POST",

            headers: {
              Authorization:
                `Bearer ${accessToken}`,

              "Content-Type":
                "application/json",
            },

            body:
              JSON.stringify({
                scheduleId:
                  result.schedule.id,
              }),
          },
        );


      const occurrenceResult =
        await occurrenceResponse
          .json()
          .catch(
            () => null,
          );


      closeSchedule();


      if (
        !occurrenceResponse.ok ||
        !occurrenceResult?.ok
      ) {
        setMessage(
          "日時設定は保存しましたが、開催予定の生成に失敗しました。",
        );

        return;
      }


      setOccurrenceRefreshKey(
        (current) =>
          current + 1,
      );


      setMessage(
        `${occurrenceResult.occurrenceCount ?? 0}件の開催予定を設定しました。`,
      );
    } catch (error) {
      console.error(
        "[CalendarManagerPanel] schedule create failed:",
        error,
      );

      setMessage(
        "日時を設定できませんでした。",
      );
    } finally {
      setScheduleSaving(
        false,
      );
    }
  }


  function openExistingSchedulePeriodEdit(
    schedule:
      CalendarSchedule,
  ) {
    /*
     * 新規日時設定フォームが開いていたら閉じる。
     */
    closeSchedule();


    setEditingExistingScheduleId(
      schedule.id,
    );

    setEditingExistingEndDate(
      schedule.end_date ??
        "",
    );

    setMessage("");
  }


  function closeExistingSchedulePeriodEdit() {
    setEditingExistingScheduleId(
      null,
    );

    setEditingExistingEndDate(
      "",
    );
  }


  async function saveExistingSchedulePeriod(
    schedule:
      CalendarSchedule,
  ) {
    if (
      existingScheduleSaving
    ) {
      return;
    }


    setMessage("");


    if (
      !schedule.end_date
    ) {
      setMessage(
        "この開催設定には終了日がありません。",
      );

      return;
    }


    if (
      !editingExistingEndDate
    ) {
      setMessage(
        "新しい終了日を入力してください。",
      );

      return;
    }


    /*
     * 現段階では「延長」のみ。
     * 短縮は予約者への影響処理と一緒に後で実装する。
     */
    if (
      editingExistingEndDate <=
      schedule.end_date
    ) {
      setMessage(
        `現在の終了日 ${schedule.end_date} より後の日付を指定してください。`,
      );

      return;
    }


    setExistingScheduleSaving(
      true,
    );


    try {
      const accessToken =
        await getAccessToken();


      if (!accessToken) {
        setMessage(
          "ログイン情報を確認できませんでした。",
        );

        return;
      }


      /*
       * 1. SCHEDULEの終了日を延長
       */
      const response =
        await fetch(
          "/api/calendar/schedules/extend",
          {
            method:
              "PATCH",

            headers: {
              Authorization:
                `Bearer ${accessToken}`,

              "Content-Type":
                "application/json",
            },

            body:
              JSON.stringify({
                scheduleId:
                  schedule.id,

                newEndDate:
                  editingExistingEndDate,
              }),
          },
        );


      const result =
        await response
          .json()
          .catch(
            () => null,
          );


      if (
        !response.ok ||
        !result?.ok ||
        !result.schedule
      ) {
        setMessage(
          result?.message ??
            "開催期間を変更できませんでした。",
        );

        return;
      }


      const updatedSchedule =
        result.schedule as
          CalendarSchedule;


      /*
       * 画面上のSCHEDULEも即更新。
       */
      setSchedules(
        (current) =>
          current.map(
            (
              currentSchedule,
            ) =>
              currentSchedule.id ===
              schedule.id
                ? updatedSchedule
                : currentSchedule,
          ),
      );


      /*
       * 2. 延長された期間の開催回を生成。
       *
       * 既存の開催回はそのまま残し、
       * 新しく必要になった回だけ追加する。
       */
      const occurrenceResponse =
        await fetch(
          "/api/calendar/occurrences",
          {
            method:
              "POST",

            headers: {
              Authorization:
                `Bearer ${accessToken}`,

              "Content-Type":
                "application/json",
            },

            body:
              JSON.stringify({
                scheduleId:
                  schedule.id,
              }),
          },
        );


      const occurrenceResult =
        await occurrenceResponse
          .json()
          .catch(
            () => null,
          );


      /*
       * カレンダーは必ず再読込。
       */
      setOccurrenceRefreshKey(
        (current) =>
          current + 1,
      );


      const completedEndDate =
        editingExistingEndDate;


      closeExistingSchedulePeriodEdit();


      if (
        !occurrenceResponse.ok ||
        !occurrenceResult?.ok
      ) {
        setMessage(
          `開催期間は ${completedEndDate} まで変更しましたが、開催予定の自動追加に失敗しました。「開催予定を生成」を押してください。`,
        );

        return;
      }


      setMessage(
        `開催期間を ${completedEndDate} まで延長しました。`,
      );
    } catch (error) {
      console.error(
        "[CalendarManagerPanel] schedule period update failed:",
        error,
      );

      setMessage(
        "開催期間を変更できませんでした。",
      );
    } finally {
      setExistingScheduleSaving(
        false,
      );
    }
  }


  async function generateAllOccurrences() {
    if (
      generatingOccurrences
    ) {
      return;
    }


    const activeSchedules =
      schedules.filter(
        (schedule) =>
          schedule.status ===
          "active",
      );


    if (
      activeSchedules.length ===
      0
    ) {
      setMessage(
        "開催日時がまだ設定されていません。",
      );

      return;
    }


    setGeneratingOccurrences(
      true,
    );

    setMessage("");


    try {
      const accessToken =
        await getAccessToken();


      if (!accessToken) {
        setMessage(
          "ログイン情報を確認できませんでした。",
        );

        return;
      }


      const results =
        await Promise.all(
          activeSchedules.map(
            async (
              schedule,
            ) => {
              const response =
                await fetch(
                  "/api/calendar/occurrences",
                  {
                    method:
                      "POST",

                    headers: {
                      Authorization:
                        `Bearer ${accessToken}`,

                      "Content-Type":
                        "application/json",
                    },

                    body:
                      JSON.stringify({
                        scheduleId:
                          schedule.id,
                      }),
                  },
                );


              const result =
                await response
                  .json()
                  .catch(
                    () => null,
                  );


              return {
                ok:
                  response.ok &&
                  result?.ok,
              };
            },
          ),
        );


      const failedCount =
        results.filter(
          (result) =>
            !result.ok,
        ).length;


      setOccurrenceRefreshKey(
        (current) =>
          current + 1,
      );


      if (
        failedCount >
        0
      ) {
        setMessage(
          `${activeSchedules.length - failedCount}件の開催設定を生成しました。${failedCount}件は生成できませんでした。`,
        );

        return;
      }


      setMessage(
        `${activeSchedules.length}件の開催設定から開催予定を生成しました。`,
      );
    } catch (error) {
      console.error(
        "[CalendarManagerPanel] occurrence generation failed:",
        error,
      );

      setMessage(
        "開催予定を生成できませんでした。",
      );
    } finally {
      setGeneratingOccurrences(
        false,
      );
    }
  }


  /*
   * ----------------------------------------------------------
   * ITEMの表示順
   *
   * calendar_item = クラス・イベントそのもの
   *
   * 通常一覧：
   *   次の開催回が早い順。
   *
   * 終了一覧：
   *   未来の開催がなく、
   *   今後も開催予定のないITEM。
   *
   * 日時未設定の新しいITEMは
   * 終了扱いにせず、通常一覧の末尾に置く。
   * ----------------------------------------------------------
   */

  const nowMs =
    Date.now();

  const today =
    getTodayInputValue();


  const nextOccurrenceByItem =
    new Map<
      string,
      CalendarOccurrenceSummary
    >();


  const lastOccurrenceTimeByItem =
    new Map<
      string,
      number
    >();


  for (
    const occurrence of
    occurrenceSummaries
  ) {
    const startsAtMs =
      new Date(
        occurrence.starts_at,
      ).getTime();

    const endsAtMs =
      new Date(
        occurrence.ends_at,
      ).getTime();


    if (
      Number.isFinite(
        startsAtMs,
      )
    ) {
      const previousLast =
        lastOccurrenceTimeByItem.get(
          occurrence.calendar_item_id,
        );


      if (
        previousLast ===
          undefined ||
        startsAtMs >
          previousLast
      ) {
        lastOccurrenceTimeByItem.set(
          occurrence.calendar_item_id,
          startsAtMs,
        );
      }
    }


    /*
     * cancelled / completed は
     * 「次回開催」には数えない。
     *
     * すでに始まっていても
     * まだ終了していない回は現在の開催として扱う。
     */
    if (
      occurrence.status !==
        "scheduled" ||
      !Number.isFinite(
        endsAtMs,
      ) ||
      endsAtMs <=
        nowMs
    ) {
      continue;
    }


    const current =
      nextOccurrenceByItem.get(
        occurrence.calendar_item_id,
      );


    if (!current) {
      nextOccurrenceByItem.set(
        occurrence.calendar_item_id,
        occurrence,
      );

      continue;
    }


    const currentStartsAtMs =
      new Date(
        current.starts_at,
      ).getTime();


    if (
      startsAtMs <
      currentStartsAtMs
    ) {
      nextOccurrenceByItem.set(
        occurrence.calendar_item_id,
        occurrence,
      );
    }
  }


  function scheduleCanStillRun(
    schedule:
      CalendarSchedule,
  ): boolean {
    /*
     * paused は終了ではない。
     * 再開可能な状態として通常一覧に残す。
     */
    if (
      schedule.status ===
      "paused"
    ) {
      return true;
    }


    if (
      schedule.status !==
      "active"
    ) {
      return false;
    }


    const freq =
      schedule
        .recurrence_rule
        ?.freq;


    /*
     * 単発イベント。
     *
     * キャンセル済みOCCURRENCEがあれば
     * 未来の日付でも終了側へ送る。
     */
    if (
      freq ===
      "once"
    ) {
      const cancelled =
        occurrenceSummaries.some(
          (
            occurrence,
          ) =>
            occurrence
              .calendar_schedule_id ===
              schedule.id &&
            occurrence.status ===
              "cancelled",
        );


      if (cancelled) {
        return false;
      }


      return (
        schedule.start_date >=
        today
      );
    }


    /*
     * 定期開催。
     *
     * 終了日なし、または終了日が今日以降なら
     * まだ現役のSCHEDULE。
     */
    return (
      !schedule.end_date ||
      schedule.end_date >=
        today
    );
  }


